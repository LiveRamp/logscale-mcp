# LogScale MCP Server Configuration
# Copy this file to '.env' and fill in your actual credentials
# The .env file should NEVER be committed to version control

# Required: Your LogScale API Token
# Get this from: LogScale UI → Settings → API Tokens
LOGSCALE_API_TOKEN=your-api-token-here

# Optional: User API Token for GraphQL operations (dashboards, alerts, repos)
# Falls back to LOGSCALE_API_TOKEN if not set
# Get this from: LogScale UI → Your Account → API Tokens
LOGSCALE_USER_API_TOKEN=your-user-api-token-here

# Required: Your LogScale instance URL
# Example: https://yourcompany.logscale.us-1.crowdstrike.com
LOGSCALE_BASE_URL=https://your-logscale-instance.com

# Required: Your LogScale repository/view name
LOGSCALE_REPOSITORY=your-repository-name

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: MCP transport — "stdio" (default, Cursor local process) or "http" (Streamable HTTP for Cursor "url" servers)
# MCP_TRANSPORT=stdio

# Streamable HTTP (when MCP_TRANSPORT=http)
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3333
# MCP_HTTP_PATH=/mcp
# Optional shared secret — require Authorization: Bearer <token> on /mcp (recommended if not only binding to localhost)
# MCP_HTTP_TOKEN=

# Optional: Dashboard schema version (default: v0.23.0)
# LOGSCALE_DASHBOARD_SCHEMA_VERSION=v0.23.0

# Optional: SSL certificate path (needed for corporate networks with SSL inspection)
# Common locations:
# - Netskope: /Library/Application Support/Netskope/STAgent/data/nscacert.pem
# - Zscaler: /usr/local/share/ca-certificates/zscaler-root-ca.crt
# - Check with your IT department if unsure
#SSL_CERT_FILE=/path/to/your/certificate.pem
